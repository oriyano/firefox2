# Vixen ships without the AI chatbot and link previews. These inert modules
# keep the paths that other browser code imports, so their menus stay hidden.

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")

MOZ_SRC_FILES += [
    "GenAI.sys.mjs",
    "LinkPreview.sys.mjs",
]
