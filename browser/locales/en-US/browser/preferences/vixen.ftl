vixen-settings-lock-header =
    .label = Settings Lock
    .description = Prevent browser settings from being changed. Only a Windows administrator can turn the lock on or off.
vixen-settings-lock-off =
    .message = Settings Lock is off. Anyone using this computer can change settings.
vixen-settings-lock-on =
    .message = Settings Lock is on. Settings can’t be changed until an administrator turns the lock off.
vixen-settings-lock-pending-on =
    .message = Settings Lock will turn on when { -brand-short-name } restarts.
vixen-settings-lock-pending-off =
    .message = Settings Lock will turn off when { -brand-short-name } restarts.
vixen-settings-lock-turn-on =
    .label = Turn on Settings Lock…
vixen-settings-lock-turn-off =
    .label = Turn off Settings Lock…
vixen-settings-lock-restart =
    .label = Restart { -brand-short-name } now
