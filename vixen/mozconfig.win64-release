# Vixen release build for Windows x64: hardened, LTO, slow to build.
ac_add_options --target=x86_64-pc-windows-msvc
ac_add_options --with-branding=browser/branding/vixen
ac_add_options --with-app-basename=Vixen
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --enable-hardening
ac_add_options --enable-lto=cross
ac_add_options --enable-rust-simd
ac_add_options --disable-tests

ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-maintenance-service
ac_add_options --disable-default-browser-agent
ac_add_options --disable-update-agent
ac_add_options --disable-bits-download
ac_add_options --disable-eme

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-vixen-release

# Google Safe Browsing key for phishing and malware warnings. Keep it out of the repository.
VIXEN_SB_KEY="$HOME/.vixen-keys/google-safebrowsing.key"
if [ -f "$VIXEN_SB_KEY" ]; then
  ac_add_options --with-google-safebrowsing-api-keyfile="$VIXEN_SB_KEY"
fi
